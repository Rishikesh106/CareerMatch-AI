# ==================================================
# CareerMatch AI — Environment Configuration Template
# ==================================================

# Server Configuration
PROJECT_NAME="CareerMatch AI"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & JWT Tokens
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
REFRESH_SECRET_KEY="replace_with_a_secure_random_refresh_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (SQLite default for zero-dependency local dev, or PostgreSQL)
DATABASE_URL="sqlite:///./career_match.db"
# DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/careermatch"

# Redis & Cache
REDIS_URL="redis://localhost:6379/0"

# AI Provider Selection: 'mock' (default zero-api-key), 'gemini', or 'openai'
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Document Storage & Limits
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Mail / SMTP (Optional for production email notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Google OAuth2 (Optional for social login integration)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
